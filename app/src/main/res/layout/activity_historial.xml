<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVolver"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/texto"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="📅 Historial"
                android:textColor="@color/texto"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Selector de mes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/fondo_tarjeta"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/btnMesAnterior"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/naranja"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMesSiguiente"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/naranja"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Totales del mes en 3 columnas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingresos"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvIngresos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/verde_ingreso"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gastos"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvGastos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rojo_egreso"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saldo"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSaldo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buscador: la X (clear_text) borra lo escrito -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBuscar"
            style="@style/Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="🔍 Buscar (ej. almuerzo, comida)"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Filtro: Todos / Ingresos / Gastos -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoFiltro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIngresos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ Ingresos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGastos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓ Gastos" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tvCantidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/contenedorMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvSinMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_tarjeta"
            android:gravity="center"
            android:padding="24dp"
            android:text="No hay movimientos aquí 🙂"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Todos los meses -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Todos los meses"
            android:textColor="@color/texto"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toca un mes para verlo"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/contenedorMeses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="6dp" />
    </LinearLayout>
</ScrollView>