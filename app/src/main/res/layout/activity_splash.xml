<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_login"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/fondo_logo"
        android:contentDescription="Logo"
        android:elevation="12dp"
        android:padding="28dp"
        android:src="@drawable/ic_billetera"
        app:tint="@color/blanco" />

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/app_name"
        android:textColor="@color/texto"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLema"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Control de ingresos y gastos"
        android:textColor="@color/texto_secundario"
        android:textSize="16sp" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:indeterminate="true"
        app:indicatorColor="@color/naranja"
        app:indicatorSize="34dp" />
</LinearLayout>